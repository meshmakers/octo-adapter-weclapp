<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <OutputType>Exe</OutputType>
        <AssemblyName>Meshmakers.Octo.Communication.MeshAdapter.WeClapp</AssemblyName>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <RootNamespace>Meshmakers.Octo.Communication.MeshAdapter.WeClapp</RootNamespace>
        <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
        <NoWarn>1701;1702;CS8002</NoWarn>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AdapterMeshWeClapp.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meshmakers.Octo.Sdk.Common.Web" Version="$(OctoCommVersion)"/>
        <PackageReference Include="Meshmakers.Octo.Sdk.MeshAdapter" Version="$(OctoCommVersion)" />
        <!-- Already transitive via Sdk.MeshAdapter (SftpUploadNode) — explicit pin because the
             DilosFileFetch trigger uses it directly. -->
        <PackageReference Include="SSH.NET" Version="2025.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lkv.WeClapp.Core\Lkv.WeClapp.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="nlog.config">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
