<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <OutputType>Exe</OutputType>
        <AssemblyName>Meshmakers.Octo.Communication.MeshAdapter.WeClapp</AssemblyName>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <RootNamespace>Meshmakers.Octo.Communication.MeshAdapter.WeClapp</RootNamespace>
        <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
        <NoWarn>1701;1702;CS8002</NoWarn>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AdapterMeshWeClapp.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meshmakers.Octo.Sdk.Common.Web" Version="$(OctoCommVersion)"/>
        <PackageReference Include="Meshmakers.Octo.Sdk.MeshAdapter" Version="$(OctoCommVersion)" />
        <!-- Maps /health, /healthz/live, /healthz/ready — the chart's httpGet probes.
             WebAdapterBuilder alone maps no HTTP endpoints (eda/mesh-adapter pattern). -->
        <PackageReference Include="Meshmakers.Octo.Services.Observability" Version="$(OctoCoreLibVersion)" />
        <!-- Already transitive via Sdk.MeshAdapter (SftpUploadNode) — explicit pin because this
             adapter uses it directly: SshNetSftpFileSystem backs the remote delete that
             DilosFileGate@1 and DilosFileConfirm@1 perform. -->
        <PackageReference Include="SSH.NET" Version="2026.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lkv.WeClapp.Core\Lkv.WeClapp.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="nlog.config">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
